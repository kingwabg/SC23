VITE_AUTH_API_URL=http://localhost:5050

# Frontend editor selection
VITE_MEETINGS_EDITOR_ENGINE=lexical
VITE_WEBHWP_BOOTSTRAP_MODE=server
VITE_WEBHWP_DEBUG=false

# Server-side WebHwp integration
WEBHWP_ENABLED=false
WEBHWP_BOOTSTRAP_MODE=server
# Example: https://webhwp.example.com/webhwpctrl/js/webhwpctrl.js
WEBHWP_SCRIPT_URL=
# Example: https://webhwp.example.com/webhwpctrl
WEBHWP_SERVICE_URL=
WEBHWP_CLIENT_ID=
WEBHWP_CLIENT_SECRET=
WEBHWP_MEETING_TEMPLATE=meeting-default

# Server-side Telegram notification integration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_PREFIX=[SC23 알림]
